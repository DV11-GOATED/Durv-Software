{
  "name": "console-shell",
  "version": "1.0.0",
  "description": "Controller-first console-style launcher / Windows shell",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "vite build && electron-builder --win portable nsis"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "local.console.shell",
    "directories": {
      "output": "release"
    },
    "productName": "ConsoleShell",
    "files": [
      "dist/**",
      "main.js",
      "preload.js",
      "lib/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}